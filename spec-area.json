{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "description": "Area chart",
    "data": {
        "values": [
            {"x": 1, "y": 30},
            {"x": 2, "y": 50},
            {"x": 3, "y": 45},
            {"x": 4, "y": 70},
            {"x": 5, "y": 60},
            {"x": 6, "y": 85}
        ]
    },
    "mark": {
        "type": "area",
        "color": "#667eea",
        "opacity": 0.6,
        "tooltip": true
    },
    "encoding": {
        "x": {
            "field": "x",
            "type": "quantitative",
            "title": "X Axis",
            "axis": {"labelFontSize": 14, "titleFontSize": 16}
        },
        "y": {
            "field": "y",
            "type": "quantitative",
            "title": "Y Axis",
            "axis": {"labelFontSize": 14, "titleFontSize": 16}
        }
    },
    "width": "100%",
    "height": 300,
    "config": {
        "view": {"stroke": "transparent"},
        "axis": {"domainWidth": 1.5}
    }
}