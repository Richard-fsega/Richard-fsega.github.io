{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "description": "Pie chart",
    "data": {
        "values": [
            {"label": "Red", "value": 40},
            {"label": "Blue", "value": 60},
            {"label": "Green", "value": 35},
            {"label": "Yellow", "value": 25}
        ]
    },
    "mark": {
        "type": "arc",
        "tooltip": true
    },
    "encoding": {
        "theta": {
            "field": "value",
            "type": "quantitative",
            "stack": true
        },
        "color": {
            "field": "label",
            "type": "nominal",
            "scale": {
                "range": ["#ff6b6b", "#48dbfb", "#1dd1a1", "#feca57"]
            },
            "legend": {"labelFontSize": 14, "titleFontSize": 16}
        }
    },
    "width": "100%",
    "height": 300,
    "config": {
        "view": {"stroke": "transparent"}
    }
}